model UserAccount {
  id                              String                                  @id
  name                            String
  email                           String                                  @unique
  normalizedEmail                 String                                  @unique
  emailVerified                   Boolean                                 @default(false)
  image                           String?
  state                           AccountState                            @default(PENDING_VERIFICATION)
  version                         Int                                     @default(1)
  twoFactorEnabled                Boolean                                 @default(false)
  stateChangedAt                  DateTime                                @default(now())
  deletedAt                       DateTime?
  createdAt                       DateTime                                @default(now())
  updatedAt                       DateTime                                @updatedAt
  accounts                        AuthProviderAccount[]
  sessions                        Session[]
  verifications                   Verification[]
  twoFactor                       TwoFactor?
  candidateIdentity               CandidateIdentity?
  securityTokens                  SecurityToken[]
  passwordResetOperations         PasswordResetOperation[]
  fullAccountRecoveryOperations   FullAccountRecoveryOperation[]
  challenges                      AuthenticationChallenge[]
  outbox                          EmailOutbox[]
  preferences                     AccountPreferences?
  jobWorkspaceState               UserJobWorkspaceState?
  emailChangeRequests             EmailChangeRequest[]
  passwordChangeAttemptWindow     PasswordChangeAttemptWindow?
  passwordChangeOperations        PasswordChangeOperation[]
  savedJobs                       SavedJob[]
  jobReports                      JobReport[]
  cvQuota                         CvAccountQuota?
  cvUploads                       CvUpload[]
  cvStoredArtifacts               CvStoredArtifact[]
  cvScanAssessments               CvScanAssessment[]
  cvExtractions                   CvExtraction[]
  cvParseJobs                     CvParseJob[]
  cvRetryRequests                 CvRetryRequest[]
  cvDrafts                        CvDraft[]
  cvConsentEvents                 CvProcessingConsent[]
  cvConfirmations                 CvImportConfirmation[]
  imageSearchQueries              SearchImageQuery[]
  imageSearchConsents             SearchProcessingConsent[]
  companyMemberships              CompanyMembership[]
  companyInvitationsSent           CompanyInvitation[]                     @relation("CompanyInvitationInviter")
  companyInvitationsAccepted       CompanyInvitation[]                     @relation("CompanyInvitationAcceptor")
  companyInvitationsDeclined       CompanyInvitation[]                     @relation("CompanyInvitationDecliner")
  teamApplicationDecisions         TeamApplication[]                        @relation("TeamApplicationDecisionMaker")
