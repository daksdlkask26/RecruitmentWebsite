 */
model JobSearchProjection {
  jobPostingId       String                 @id
  titleIds           String[]               @default([])
  occupationIds      String[]               @default([])
  facetIds           String[]               @default([])
  canonicalTitleVi   String?                @db.VarChar(160)
  canonicalTitleEn   String?                @db.VarChar(160)
  normalizedTitle    String                 @db.VarChar(200)
  normalizedAliases  String[]               @default([])
  normalizedSkills   String[]               @default([])
  profileSource      JobSearchProfileSource
  profileConfidence  Float
  translationStatus  JobSearchTranslationStatus @default(UNMAPPED)
  mappingSource      JobSearchMappingSource @default(MANUAL_REVIEW)
  mappingConfidence  Float                  @default(0)
  catalogVersion     String                 @db.VarChar(64)
  updatedAt          DateTime               @updatedAt
  jobPosting         JobPosting             @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([catalogVersion, profileSource])
  @@index([catalogVersion, translationStatus])
  @@index([titleIds], type: Gin)
  @@index([occupationIds], type: Gin)
  @@index([facetIds], type: Gin)
  @@index([normalizedAliases], type: Gin)
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "JobSearchProjection_normalizedTitle_trgm_idx")
}

