  createdByAdminUserId        String?
  sourceSupportConversationId String?
  reason                      String?                                 @db.VarChar(500)
  state                       ProfessionalConnectionProposalState     @default(PENDING_BOTH)
  expiresAt                   DateTime
  version                     Int                                     @default(1)
  terminalAt                  DateTime?
  ordinaryDetailHiddenAt      DateTime?
  protectedDeleteAfter        DateTime?
  protectedDeletedAt          DateTime?
