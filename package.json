    "cv:scanner:check": "npm run cv:scanner:check --workspace @smarthire/web",
    "ocr:up": "docker compose up -d --build ocr-engine",
    "ocr:check": "npm run ocr:check --workspace @smarthire/web",
    "ocr:test": "node scripts/run-ocr-tests.mjs",
    "image-search:worker": "npm run image-search:worker --workspace @smarthire/web",
    "image-search:worker:probe": "npm run image-search:worker:probe --workspace @smarthire/web",
    "admin:worker": "npm run admin:worker --workspace @smarthire/web",
    "admin:worker:probe": "npm run admin:worker:probe --workspace @smarthire/web",
    "admin:evidence:check": "npm run admin:evidence:check --workspace @smarthire/web",
    "admin:contracts": "npm run admin:contracts --workspace @smarthire/web",
    "test:admin-user-verification": "npm run test:admin-user-verification --workspace @smarthire/web --",
    "test:admin-user-verification:e2e": "npm run test:admin-user-verification:e2e --workspace @smarthire/web --",
    "perf:admin-user-verification": "npm run perf:admin-user-verification --workspace @smarthire/web --",
    "usability:admin-user-verification": "npm run usability:admin-user-verification --workspace @smarthire/web --",
    "admin:provision": "npm run admin:provision --workspace @smarthire/web --",
    "admin:revoke": "npm run admin:revoke --workspace @smarthire/web --",
    "admin:moderation:migration:verify": "npm run admin:moderation:migration:verify --workspace @smarthire/web",
    "business-verification:migration:verify": "npm run business-verification:migration:verify --workspace @smarthire/web",
    "perf:business-verification": "npm run perf:business-verification --workspace @smarthire/web",
    "admin:notifications:reconcile": "npm run admin:notifications:reconcile --workspace @smarthire/web --",
    "image-search:storage:preflight": "npm run image-search:storage:preflight --workspace @smarthire/web",
    "ocr:corpus:evaluate": "npm run ocr:corpus:evaluate --workspace @smarthire/web",
    "perf:image-search": "npm run perf:image-search --workspace @smarthire/web",
    "perf:image-search:self-test": "npm run perf:image-search:self-test --workspace @smarthire/web",
    "ocr:supply-chain": "node scripts/verify-ocr-supply-chain.mjs",
    "perf:profile-account": "npm run perf:profile-account --workspace @smarthire/web",
    "perf:job-board": "npm run perf:job-board --workspace @smarthire/web",
    "perf:admin-management": "npm run perf:admin-management --workspace @smarthire/web",
    "perf:admin-management:self-test": "npm run perf:admin-management:self-test --workspace @smarthire/web",
    "build": "npm run build --workspace @smarthire/web",
    "lint": "npm run lint --workspace @smarthire/web",
    "typecheck": "npm run typecheck --workspace @smarthire/web",
    "test": "npm run test --workspace @smarthire/web",
    "test:candidate-first": "npm run test:candidate-first --workspace @smarthire/web",
    "test:candidate-first:e2e": "npm run test:candidate-first:e2e --workspace @smarthire/web",
    "perf:candidate-first:home": "npm run perf:candidate-first:home --workspace @smarthire/web",
    "perf:candidate-first:realtime": "npm run perf:candidate-first:realtime --workspace @smarthire/web",
    "verify:candidate-first:restore": "npm run verify:candidate-first:restore --workspace @smarthire/web",
    "triage:candidate-first:vitest": "npm run triage:candidate-first:vitest --workspace @smarthire/web",
    "update:candidate-first:verification": "npm run update:candidate-first:verification --workspace @smarthire/web",
    "test:job-board": "npm run test:job-board --workspace @smarthire/web",
    "test:search:e2e": "npm run test:search:e2e --workspace @smarthire/web",
    "test:admin-management": "npm run test:admin-management --workspace @smarthire/web",
    "test:admin-management:e2e": "npm run test:admin-management:e2e --workspace @smarthire/web",
    "test:messaging": "npm run test:messaging --workspace @smarthire/web",
    "test:messaging:e2e": "npm run test:messaging:e2e --workspace @smarthire/web",
    "test:cv-import": "npm run test:cv-import --workspace @smarthire/web",
    "test:cv-import:e2e": "npm run test:cv-import:e2e --workspace @smarthire/web",
    "test:candidate-application-private-match": "npm run test:candidate-application-private-match --workspace @smarthire/web",
    "test:ocr-image-search": "npm run test:ocr-image-search --workspace @smarthire/web",
    "test:ocr-image-search:e2e": "npm run test:ocr-image-search:e2e --workspace @smarthire/web",
    "test:e2e": "npm run test:e2e --workspace @smarthire/web",
    "test:business-verification": "npm run test:business-verification --workspace @smarthire/web",
    "perf:messaging": "npm run perf:messaging --workspace @smarthire/web",
    "perf:notifications": "npm run perf:notifications --workspace @smarthire/web",
    "test:notifications": "npm run test:notifications --workspace @smarthire/web",
    "notifications:migrate:legacy": "npm run notifications:migrate:legacy --workspace @smarthire/web",
    "notifications:migration:verify": "npm run notifications:migration:verify --workspace @smarthire/web",
    "smoke:messaging:server": "npm run smoke:messaging:server --workspace @smarthire/web",
    "db:validate": "npm run db:validate --workspace @smarthire/web",
    "db:migrate": "npm run db:migrations:check --workspace @smarthire/web && npm run db:up && npm run db:migrations:reconcile-names --workspace @smarthire/web -- --apply && npm run db:migrate --workspace @smarthire/web",
    "db:studio": "npm run db:studio --workspace @smarthire/web",
    "search:catalog:reconcile": "npm run search:catalog:reconcile --workspace @smarthire/web --",
    "search:review:queue": "npm run search:review:queue --workspace @smarthire/web --",
    "search:review:manifest": "npm run search:review:manifest --workspace @smarthire/web --",
    "search:review:batch": "npm run search:review:batch --workspace @smarthire/web --"
  },
  "dependencies": {
    "motion": "^12.42.2"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true
  },
  "devDependencies": {
    "prisma": "7.9.0"
  }
}
