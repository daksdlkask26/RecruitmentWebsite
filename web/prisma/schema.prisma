/// A recruiter-entered sub-industry is held against the immutable review
/// version. Approval either creates a new shared row or maps to an existing
/// normalized row, so duplicate names never create duplicate public options.
model JobTaxonomyProposal {
  id                    String                     @id @default(cuid())
  industryId            String                     @db.VarChar(80)
  companyId             String
  requestedByUserId     String
  reviewVersionId       String                     @unique
  proposedName          String                     @db.VarChar(160)
  normalizedName        String                     @db.VarChar(160)
  description           String?                    @db.VarChar(1000)
  status                JobTaxonomyProposalStatus @default(PENDING_APPROVAL)
  resolvedSubIndustryId String?                    @db.VarChar(128)
  reviewedByAdminUserId String?
  reviewedAt           DateTime?
  reviewReason         String?                    @db.VarChar(1000)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  industry              JobIndustry                @relation(fields: [industryId], references: [id], onDelete: Restrict)
  company               Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy           UserAccount                @relation("JobTaxonomyProposalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewVersion         JobPostReviewVersion       @relation(fields: [reviewVersionId], references: [id], onDelete: Restrict)
  resolvedSubIndustry   JobSubIndustry?            @relation("ResolvedTaxonomyProposals", fields: [resolvedSubIndustryId], references: [id], onDelete: SetNull)

  @@index([status, createdAt, id])
  @@index([industryId, normalizedName, status])
  @@index([companyId, createdAt])
}

