  blocked       UserAccount @relation("MessagingBlocked", fields: [blockedUserId], references: [id], onDelete: Restrict)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId, blockerUserId])
}

model MessagingReport {
  id                       String                       @id @default(cuid())
  reporterUserId           String
  targetUserId             String
  conversationId           String?
  recruitmentThreadId      String?
  targetType               MessagingReportTargetType
  evidenceMessageId        String?
  recruitmentEvidenceMessageId String?
  category                 ModerationReportCategory
  normalizedDetail         String?
  state                    ModerationReportState        @default(PENDING_REVIEW)
  assignedAdminUserId      String?
  handledByAdminUserId     String?
  enforcementCorrelationId String?                      @db.VarChar(128)
  version                  Int                          @default(1)
  unresolvedKey            String?                      @unique
  handledAt                DateTime?
  preserveUntil            DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  reporter                 UserAccount                  @relation("MessagingReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  target                   UserAccount                  @relation("MessagingTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  assignedAdmin            UserAccount?                 @relation("MessagingReportAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  handledByAdmin           UserAccount?                 @relation("MessagingReportHandler", fields: [handledByAdminUserId], references: [id], onDelete: SetNull)
  conversation             MessagingConversation?       @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  evidenceMessage          MessagingMessage?            @relation("MessagingReportEvidence", fields: [evidenceMessageId], references: [id], onDelete: SetNull)
  recruitmentThread        RecruitmentThread?           @relation("RecruitmentThreadReports", fields: [recruitmentThreadId], references: [id], onDelete: Cascade)
  recruitmentEvidenceMessage RecruitmentMessage?        @relation("RecruitmentReportEvidence", fields: [recruitmentEvidenceMessageId], references: [id], onDelete: SetNull)
  reviewEvents             MessagingReportReviewEvent[]
  privateNotes             MessagingReportPrivateNote[]

  @@index([reporterUserId, createdAt(sort: Desc)])
  @@index([conversationId, state, createdAt])
