FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS dependencies

WORKDIR /app

COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
RUN npm ci --omit=dev --ignore-scripts

FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS runtime

WORKDIR /app

ENV NODE_ENV=development \
    CV_STORAGE_LOCAL_ROOT=/app/.local/cv-storage \
    CV_CLAMD_SOCKET_PATH=/run/clamav/clamd.sock

# Keep the pinned Node/Alpine base reproducible while applying the current
# Alpine security patch level to the runtime OpenSSL package. Alpine 3.23's
# stable repository has not published the fixed 3.5.8-r0 package yet.
RUN apk add --no-cache --upgrade \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main \
    openssl

RUN rm -rf \
    /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
    /usr/local/bin/pnpm \
    /usr/local/bin/pnpx \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg

RUN install -d -o node -g node -m 0700 /app/.local/cv-storage

WORKDIR /app/web
COPY --from=dependencies --chown=node:node /app/node_modules /app/node_modules
COPY --from=dependencies --chown=node:node /app/web/node_modules /app/web/node_modules
COPY --chown=node:node package.json /app/package.json
COPY --chown=node:node web/package.json web/tsconfig.json web/prisma.config.ts ./
COPY --chown=node:node web/prisma ./prisma
COPY --chown=node:node web/scripts ./scripts
COPY --chown=node:node web/src ./src
USER node

CMD ["node", "--conditions=react-server", "--import", "tsx", "scripts/run-cv-worker.mjs"]
