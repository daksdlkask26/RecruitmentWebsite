  confidenceMetadata    Json
  exclusionFlags        Json
  automaticResult       PrivateAutomaticMatchResult @relation(fields: [automaticResultId], references: [id], onDelete: Cascade)

  @@index([automaticResultId, classification, id], map: "PrivateMatchEvidence_result_idx")
}

model PrivateCvMatchCommandReceipt {
