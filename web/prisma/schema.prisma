}

model SearchProjectionReconciliationRun {
  id                 String                       @id @default(cuid())
  catalogVersionId   String
  mode               SearchReconciliationRunMode
  status             SearchReconciliationRunStatus @default(RUNNING)
  inspected          Int                          @default(0)
  refreshed          Int                          @default(0)
  missing            Int                          @default(0)
  stale              Int                          @default(0)
  inconsistent       Int                          @default(0)
  unmapped           Int                          @default(0)
  ambiguous          Int                          @default(0)
  requiresReview     Int                          @default(0)
  orphaned           Int                          @default(0)
  policyFailures     Int                          @default(0)
  cursor             String?
  errorMessage       String?                      @db.VarChar(2000)
  createdByAdminUserId String?
  startedAt          DateTime                     @default(now())
  completedAt        DateTime?

  @@index([catalogVersionId, startedAt(sort: Desc), id])
  @@index([status, startedAt(sort: Desc), id])
}
