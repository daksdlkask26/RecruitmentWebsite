/// Recruitment messaging is deliberately separate from a social messaging
/// conversation. It has one durable business context (an application), a
/// single accountable assignee, and company-owner oversight without making the
/// owner a message participant.
model RecruitmentThread {
  id                         String                  @id @default(cuid())
  applicationId              String                  @unique
  companyId                  String
  jobPostingId               String
  candidateUserId            String
  assignedMembershipId       String?
  state                      RecruitmentThreadState  @default(OPEN)
  nextMessageSequence        Int                     @default(1)
  lastMessageSequence        Int?
  lastMessageAt              DateTime?
  candidateLastReadSequence  Int                     @default(0)
  staffLastReadSequence      Int                     @default(0)
  candidateLastReadAt        DateTime?
  staffLastReadAt            DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  application                JobApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company                    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobPosting                 JobPosting              @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  candidate                  UserAccount             @relation("RecruitmentThreadCandidate", fields: [candidateUserId], references: [id], onDelete: Restrict)
  assignedMembership         CompanyMembership?      @relation("RecruitmentThreadAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  messages                   RecruitmentMessage[]
  reports                    MessagingReport[]     @relation("RecruitmentThreadReports")

  @@index([companyId, lastMessageAt(sort: Desc), id])
  @@index([jobPostingId, lastMessageAt(sort: Desc), id])
  @@index([assignedMembershipId, lastMessageAt(sort: Desc), id])
  @@index([candidateUserId, lastMessageAt(sort: Desc), id])
  @@index([state, lastMessageAt(sort: Desc), id])
}

model RecruitmentMessage {
  id                 String              @id @default(cuid())
  threadId           String
  sequence           Int
  senderUserId       String
  senderMembershipId String?
  clientOperationId  String
  content            String              @db.Text
  createdAt          DateTime            @default(now())
  thread             RecruitmentThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender             UserAccount         @relation("RecruitmentMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  evidenceForReports MessagingReport[]   @relation("RecruitmentReportEvidence")

  @@unique([threadId, sequence])
  @@unique([senderUserId, clientOperationId])
  @@index([threadId, sequence(sort: Desc)])
}

model MessagingConversation {
