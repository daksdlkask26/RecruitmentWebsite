  @@index([candidateUserId, aiAnalysisConsent])
  @@index([jobPostingId, submittedAt(sort: Desc), id(sort: Desc)])
  @@index([documentDeletedAt, documentDeletionDueAt])
  @@index([profileSnapshotAccessDeniedAt, profileSnapshotReviewDueAt])
  @@index([jobPostingId, currentScoringResultId, submittedAt(sort: Desc), id(sort: Desc)])
}

model JobApplicationContactConsent {
